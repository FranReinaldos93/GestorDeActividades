<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="900.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador.ActividadesController">
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="212.0" prefWidth="200.0" spacing="15.0" style="-fx-background-color: #C8CACC;" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Button fx:id="btnInicio" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAbrirInicio" prefHeight="40.0" style="-fx-background-color: transparent;" text="Inicio">
               <graphic>
                  <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagenes/logo_hogar.png" />
                     </image>
                  </ImageView>
               </graphic>
               <padding>
                  <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
               </padding>
            </Button>
            <Button fx:id="btnInscripcion" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAbrirInscripcion" prefHeight="40.0" style="-fx-background-color: transparent;" text="Inscripción">
               <graphic>
                  <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagenes/agregar-usuario.png" />
                     </image>
                  </ImageView>
               </graphic>
               <padding>
                  <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
               </padding>
            </Button>
            <Button fx:id="btnActividades" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAbrirActividades" prefHeight="40.0" style="-fx-background-color: #52A3F7; -fx-background-radius: 7;" text="Actividades">
               <graphic>
                  <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagenes/lista.png" />
                     </image>
                  </ImageView>
               </graphic>
               <padding>
                  <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
               </padding>
            </Button>
            <Button fx:id="btnConfiguracion" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAbrirConfiguracion" prefHeight="40.0" style="-fx-background-color: transparent;" text="Configuración">
               <graphic>
                  <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagenes/ajustes.png" />
                     </image>
                  </ImageView>
               </graphic>
               <padding>
                  <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
               </padding>
            </Button>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </left>
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Archivo">
                  <items>
                    <MenuItem fx:id="miNuevo" mnemonicParsing="false" onAction="#onMenuBarNuevo" text="Nuevo" />
                        <MenuItem fx:id="miGuardar" mnemonicParsing="false" onAction="#onMenuBarGuardar" text="Guardar" />
                        <MenuItem fx:id="miSalir" mnemonicParsing="false" onAction="#onMenuBarSalir" text="Salir" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edición">
                  <items>
                    <MenuItem fx:id="miPreferencias" mnemonicParsing="false" onAction="#onMenuBarPreferencias" text="Preferencias" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Ayuda">
                  <items>
                    <MenuItem fx:id="miAcercaDe" mnemonicParsing="false" onAction="#onMenuBarAcercaDe" text="Acerca de" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagenes/logo_cabecera.png" />
                     </image>
                  </ImageView>
                  <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="400.0" spacing="5.0">
                     <children>
                        <Label text="Gestor de Actividades">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font></Label>
                        <Label text="Organiza, descubre e inscribete en actividades del centro" />
                     </children>
                  </VBox>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagenes/logo_usuario.png" />
                     </image>
                  </ImageView>
                  <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="250.0" spacing="5.0">
                     <children>
                        <Label text="Fco Javier Reinaldos">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font></Label>
                        <Label text="Alumno 2º DAM" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets left="20.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" style="-fx-background-color: E9F2F5;" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="110.0" prefWidth="900.0" spacing="5.0" style="-fx-background-color: #e0ecfb; -fx-background-radius: 20;">
               <children>
                  <Label text="Gestión de actividades">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Organiza, descubre e inscribete en actividades del centro" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="30.0" right="10.0" top="22.0" />
               </padding>
            </VBox>
            <TabPane fx:id="tabpActividades" maxWidth="1.7976931348623157E308" prefHeight="385.0" prefWidth="880.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
              <tabs>
                <Tab text="Todas">
                  <content>
                        <VBox>
                           <children>
                              <HBox prefHeight="47.0" prefWidth="856.0" spacing="10.0">
                                 <children>
                                    <TextField fx:id="txfBuscar" promptText="Buscar Actividades..." HBox.hgrow="ALWAYS" />
                                    <ComboBox fx:id="cbCategorias" prefWidth="150.0" promptText="Categoría" />
                                    <ComboBox fx:id="cbEstado" prefWidth="150.0" promptText="Estado" />
                                    <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#onBuscarActividad" prefHeight="33.0" prefWidth="88.0" style="-fx-background-color: #e0ecfb; -fx-background-radius: 8;" text="Buscar">
                                       <graphic>
                                          <ImageView fitHeight="12.0" fitWidth="12.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@../Imagenes/busqueda.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                       <font>
                                          <Font name="System Bold" size="12.0" />
                                       </font>
                                    </Button>
                                    <Button fx:id="btnNuevaActividad" mnemonicParsing="false" onAction="#onDialogoNuevaActividad" prefHeight="33.0" prefWidth="116.0" style="-fx-background-color: #52A3F7; -fx-background-radius: 5;" text="Nueva Actividad">
                                       <font>
                                          <Font name="System Bold" size="12.0" />
                                       </font></Button>
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="15.0" />
                                 </padding>
                              </HBox>
                              <TableView prefHeight="382.0" prefWidth="857.0" VBox.vgrow="ALWAYS">
                                <columns>
                                  <TableColumn prefWidth="200.0" text="Actividad" />
                                  <TableColumn prefWidth="150.0" text="Categoria" />
                                    <TableColumn prefWidth="125.0" text="Fecha" />
                                    <TableColumn prefWidth="75.0" text="Plazas" />
                                    <TableColumn prefWidth="125.0" text="Estado" />
                                </columns>
                              </TableView>
                           </children>
                        </VBox>
                  </content>
                </Tab>
                <Tab text="Culturales">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                  </content>
                </Tab>
                  <Tab text="Deportivas">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
                  <Tab text="Técnológicas">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                  </Tab>
              </tabs>
            </TabPane>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <VBox prefHeight="100.0" prefWidth="308.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10;">
                     <children>
                        <HBox prefHeight="32.0" prefWidth="288.0" spacing="7.0">
                           <children>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../Imagenes/informacion.png" />
                                 </image>
                              </ImageView>
                              <Label text="Detalles de la actividad seleccionada">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <Label text="Seleciona una actividad de la tabla" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="100.0" prefWidth="233.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10;">
                     <children>
                        <HBox prefHeight="32.0" prefWidth="213.0" spacing="7.0">
                           <children>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../Imagenes/informacion.png" />
                                 </image>
                              </ImageView>
                              <Label text="Resumen de actividades">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <Label text="12 total" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <VBox prefHeight="100.0" prefWidth="233.0" spacing="10.0" style="-fx-background-color: #FFFF82; -fx-background-radius: 10;">
                     <children>
                        <HBox prefHeight="32.0" prefWidth="213.0" spacing="7.0">
                           <children>
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../Imagenes/informacion.png" />
                                 </image>
                              </ImageView>
                              <Label text="Pestaña de actividades">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <Label fx:id="lblPestañaAct" text="Pestaña actual: Todas">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></VBox>
   </center>
   <bottom>
      <HBox prefHeight="32.0" prefWidth="582.0" spacing="80.0" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Label text="Gestor de Actividades . v1.0 | IES Jose Luis Martinez Palomo" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label text="2ºDAM | Desarrollo de interfaces" />
         </children>
         <padding>
            <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
         </padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </HBox>
   </bottom>
</BorderPane>
